---
import App from '../components/App.tsx';
import '../styles/global.css';

// Link previews (WhatsApp, Telegram, X…). Crawlers don't run JS, so these are static.
// nginx swaps shareTitle/shareText for "look at this equation" copy when the link has ?q=
// (sub_filter matches these exact strings; see README "Link previews"). No og:url on purpose:
// some crawlers re-fetch og:url and would lose the ?q= variant.
const pageUrl = new URL(`${import.meta.env.BASE_URL}/`, Astro.site).href;
const ogImage = new URL(`${import.meta.env.BASE_URL}/og-image.jpg`, Astro.site).href;
const shareTitle = '🤯 ¿Puedes resolver esta ecuación? | Álgebra 3D';
const shareText = 'Escribe cualquier ecuación y mírala resolverse paso a paso en 3D, con balanzas, bloques y gráficas. ¡Pruébalo gratis!';
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Aprende álgebra en 3D: escribe una ecuación y mírala resolverse paso a paso con bloques, balanzas y gráficas." />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Álgebra 3D" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareText} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Álgebra 3D: una balanza con bloques de álgebra" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareText} />
    <meta name="twitter:image" content={ogImage} />
    <title>Álgebra 3D</title>
  </head>
  <body>
    <App client:only="preact" />
    <noscript>Algebra 3D needs JavaScript and WebGL.</noscript>
  </body>
</html>
