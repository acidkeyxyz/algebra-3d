---
import App from '../components/App.tsx';
import '../styles/global.css';

// Link previews (WhatsApp, Telegram, X…). Crawlers don't run JS, so every link, with or
// without ?q=, gets this same preview.
const pageUrl = new URL(`${import.meta.env.BASE_URL}/`, Astro.site).href;
const ogImage = new URL(`${import.meta.env.BASE_URL}/og-image.jpg`, Astro.site).href;
const shareTitle = '🤯 ¿Puedes resolver esta ecuación? | Álgebra 3D';
const shareText = 'Aprende mates jugando: niveles, estrellas e insignias de sumas a álgebra (8 a 13 años). Y resuelve ecuaciones paso a paso en 3D. ¡Pruébalo gratis!';
---
<!doctype html>
<html lang="es-MX">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5LVBNRR2');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Aprende mates jugando (8 a 13 años): sumas, multiplicaciones, divisiones, fracciones y álgebra con niveles, estrellas e insignias. Y resuelve ecuaciones en 3D paso a paso." />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Álgebra 3D" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareText} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Álgebra 3D: una balanza con bloques de álgebra" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareText} />
    <meta name="twitter:image" content={ogImage} />
    <title>Álgebra 3D</title>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5LVBNRR2"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <App client:only="preact" />
    <noscript>Algebra 3D needs JavaScript and WebGL.</noscript>
  </body>
</html>
